{
  "name": "fabulist-chrome-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Fabulist PoC — RPG 式情緒 HUD 與回信輔助 (Gmail)",
  "type": "module",
  "scripts": {
    "build": "esbuild src/background/index.js --bundle --format=esm --target=chrome120 --loader:.md=text --outfile=dist/background.js",
    "watch": "npm run build -- --watch",
    "smoke": "esbuild scripts/smoke.js --bundle --platform=node --format=esm --loader:.md=text --outfile=.smoke/smoke.mjs --log-level=warning && node .smoke/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
